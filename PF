<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#09080d">
  <meta name="description" content="The portfolio of Hishantkumar — developer, maker, and curious mind.">
  <title>Hishantkumar — Developer &amp; Builder</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{color-scheme:dark;--ink:#f5f1f8;--muted:#a49baa;--quiet:#766d7f;--bg:#09080d;--line:rgba(235,219,255,.11);--purple:#a77bff;--red:#ff526d;--gold:#f1c77b;--mono:"DM Mono",monospace;--sans:"Manrope",sans-serif;--max:1080px}
    *,*::before,*::after{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:82px}body{margin:0;background:radial-gradient(ellipse at 82% 13%,rgba(119,53,161,.15),transparent 34rem),radial-gradient(ellipse at 7% 47%,rgba(142,35,63,.09),transparent 31rem),var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}a:focus-visible{outline:2px solid var(--gold);outline-offset:4px}::selection{color:#09080d;background:var(--gold)}.wrap{width:min(var(--max),calc(100% - 44px));margin-inline:auto}
    .topbar{position:sticky;z-index:5;top:0;border-bottom:1px solid rgba(255,255,255,.07);background:rgba(9,8,13,.8);backdrop-filter:blur(18px)}nav{min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:800;letter-spacing:-.04em}.mark{width:27px;height:27px;display:grid;place-items:center;border:1px solid rgba(241,199,123,.55);border-radius:8px;color:var(--gold);font:11px var(--mono);transform:rotate(-7deg)}.navlinks{display:flex;gap:clamp(16px,3vw,32px)}.navlinks a{color:var(--muted);font-size:11px;transition:color .2s}.navlinks a:hover{color:var(--ink)}.navlinks .gh{color:var(--gold)}
    .hero{min-height:620px;display:grid;align-items:center;position:relative;padding:70px 0 90px}.hero-grid{display:grid;grid-template-columns:1fr 300px;align-items:center;gap:65px}.eyebrow,.kicker{color:var(--gold);font:10px var(--mono);letter-spacing:.14em;text-transform:uppercase}.eyebrow:before{content:"";display:inline-block;width:20px;height:1px;margin:0 10px 3px 0;background:currentColor}h1{margin:22px 0 19px;font-size:clamp(48px,8vw,88px);line-height:1;letter-spacing:-.085em}h1 span{color:var(--purple)}.intro{max-width:560px;margin:0;color:var(--muted);font-size:16px;line-height:1.9}.intro strong{color:var(--ink);font-weight:600}.actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:30px}.button{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:0 16px;border:1px solid var(--line);border-radius:9px;font-size:11px;font-weight:700;transition:transform .2s,border-color .2s}.button:hover{transform:translateY(-2px);border-color:rgba(241,199,123,.5)}.button.primary{border:0;background:linear-gradient(110deg,#a77bff,#d65b91 65%,#ed796b);color:#110b16}.visual{position:relative;width:min(100%,285px);aspect-ratio:1;justify-self:center}.orbit{position:absolute;inset:-17px;border:1px solid rgba(167,123,255,.2);border-radius:50%;animation:spin 34s linear infinite}.orbit:before{content:"";position:absolute;top:17%;right:12%;width:7px;height:7px;border-radius:50%;background:var(--gold);box-shadow:0 0 17px var(--gold)}.frame{position:absolute;inset:0;overflow:hidden;border:1px solid rgba(241,199,123,.45);border-radius:36% 64% 57% 43%/45% 39% 61% 55%;background:linear-gradient(145deg,#281b39,#14101b 67%,#381621);box-shadow:0 25px 90px rgba(118,58,146,.2);animation:morph 12s ease-in-out infinite}.frame:after{content:"";position:absolute;inset:58% 0 0;background:linear-gradient(transparent,rgba(11,8,14,.5));pointer-events:none}.avatar{width:100%;height:100%;object-fit:cover}.avatar[hidden]{display:none}.fallback{position:absolute;inset:0;display:grid;place-items:center;color:var(--gold);font-size:78px;font-weight:800}.tag{position:absolute;z-index:1;right:-25px;bottom:22px;display:flex;align-items:center;gap:9px;padding:11px 13px;border:1px solid var(--line);border-radius:11px;background:rgba(17,14,23,.94);color:var(--muted);font:10px var(--mono)}.dot{width:8px;height:8px;border-radius:50%;background:#71d5a5;box-shadow:0 0 12px #71d5a5}
    .section{padding:90px 0;border-top:1px solid rgba(255,255,255,.07)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:35px}.kicker{color:var(--red)}h2{margin:11px 0 0;font-size:clamp(31px,5vw,47px);line-height:1.08;letter-spacing:-.065em}.note{max-width:350px;margin:0;color:var(--muted);font-size:12px;line-height:1.8}.about-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px}.about-copy{color:var(--muted);font-size:14px;line-height:2}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.stat{min-height:105px;padding:18px;border:1px solid var(--line);border-radius:12px;background:linear-gradient(145deg,rgba(255,255,255,.035),transparent)}.stat b{display:block;color:var(--gold);font-size:26px;letter-spacing:-.06em}.stat span{display:block;margin-top:7px;color:var(--muted);font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase}.location{margin-top:16px;color:var(--quiet);font:10px var(--mono)}.projects-section{background:linear-gradient(180deg,rgba(121,53,145,.035),transparent 45%)}.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card{min-height:225px;display:flex;flex-direction:column;padding:21px;border:1px solid var(--line);border-radius:13px;background:linear-gradient(155deg,rgba(255,255,255,.035),rgba(255,255,255,.008));transition:transform .24s,border-color .24s,background .24s}.card:hover{transform:translateY(-5px);border-color:rgba(167,123,255,.48);background:linear-gradient(155deg,rgba(167,123,255,.09),rgba(255,255,255,.01))}.cardtop,.meta{display:flex;align-items:center;justify-content:space-between;color:var(--quiet);font:9px var(--mono)}.cardtop b{color:var(--gold);font-size:16px}.card h3{margin:23px 0 9px;font-size:16px;letter-spacing:-.04em}.card p{margin:0;color:var(--muted);font-size:11px;line-height:1.8}.meta{justify-content:flex-start;gap:14px;margin-top:auto;padding-top:20px}.empty{grid-column:1/-1;padding:20px;border:1px dashed var(--line);border-radius:11px;color:var(--muted);font-size:12px;line-height:1.8}.empty a{color:var(--gold);text-decoration:underline;text-underline-offset:3px}
    .contact{padding:95px 0}.contact-panel{position:relative;overflow:hidden;padding:clamp(30px,6vw,60px);border:1px solid rgba(241,199,123,.2);border-radius:17px;background:radial-gradient(ellipse at 90% 10%,rgba(152,72,147,.18),transparent 48%),linear-gradient(135deg,#15101b,#0d0b11 72%)}.contact-panel:after{content:"";position:absolute;right:-90px;bottom:-180px;width:320px;height:320px;border:1px solid rgba(241,199,123,.14);border-radius:50%;box-shadow:0 0 0 35px rgba(241,199,123,.025),0 0 0 70px rgba(241,199,123,.02);pointer-events:none}.contact-panel p{max-width:480px;margin:15px 0 23px;color:var(--muted);font-size:13px;line-height:1.8}.footer{padding:22px 0;border-top:1px solid rgba(255,255,255,.07);color:var(--quiet);font:9px var(--mono)}.foot{display:flex;justify-content:space-between;gap:15px}.foot a{color:var(--muted)}
    .reveal{opacity:0;transform:translateY(20px);transition:opacity .7s cubic-bezier(.2,.7,.2,1),transform .7s cubic-bezier(.2,.7,.2,1);transition-delay:var(--delay,0ms)}.reveal.visible{opacity:1;transform:translateY(0)}.hero .reveal{animation:enter .8s cubic-bezier(.2,.7,.2,1) both;animation-delay:var(--delay,0ms)}@keyframes enter{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes morph{0%,100%{border-radius:36% 64% 57% 43%/45% 39% 61% 55%}50%{border-radius:58% 42% 42% 58%/42% 58% 42% 58%}}
    @media(max-width:740px){.hero{min-height:auto;padding:60px 0 80px}.hero-grid{grid-template-columns:1fr;gap:48px}.visual{width:210px;grid-row:1}.about-grid{grid-template-columns:1fr;gap:25px}.section{padding:70px 0}.projects{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:500px){.wrap{width:calc(100% - 34px)}nav{min-height:62px}.navlinks{gap:13px}.navlinks a{font-size:10px}.navlinks a:nth-child(2){display:none}.hero{padding-top:48px}.visual{width:180px}.section-head{align-items:flex-start;flex-direction:column}.projects{grid-template-columns:1fr}.card{min-height:205px}.foot{flex-direction:column}}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}.reveal{opacity:1;transform:none}}
  </style>
</head>
<body>
  <header class="topbar"><nav class="wrap" aria-label="Main navigation">
    <a class="brand" href="#home"><span class="mark">H</span><span id="brand-name">Hishantkumar</span></a>
    <div class="navlinks"><a href="#about">About</a><a href="#projects">Projects</a><a href="#contact">Contact</a><a class="gh" href="https://github.com/Hishantkumar" target="_blank" rel="noreferrer">GitHub ↗</a></div>
  </nav></header>
  <main>
    <section class="hero wrap" id="home"><div class="hero-grid">
      <div>
        <div class="eyebrow reveal" style="--delay:80ms">Personal portfolio</div>
        <h1 class="reveal" style="--delay:200ms">Building things<br>with <span>purpose.</span></h1>
        <p class="intro reveal" style="--delay:320ms">Hey, I’m <strong id="hero-name">Hishantkumar</strong> — a developer who loves turning thoughtful ideas into useful digital experiences. I believe the best work lives where <strong>craft meets curiosity.</strong></p>
        <div class="actions reveal" style="--delay:440ms"><a class="button primary" href="#projects">Explore my work ↓</a><a class="button" href="https://github.com/Hishantkumar" target="_blank" rel="noreferrer">⌘ GitHub profile</a></div>
      </div>
      <div class="visual reveal" style="--delay:280ms" aria-label="GitHub profile picture">
        <div class="orbit" aria-hidden="true"></div><div class="frame"><div class="fallback" id="fallback">H</div><img class="avatar" id="avatar" src="https://github.com/Hishantkumar.png?size=600" alt="Hishantkumar's GitHub profile picture" fetchpriority="high"></div>
        <div class="tag"><span class="dot" aria-hidden="true"></span><span id="handle">@Hishantkumar</span></div>
      </div>
    </div></section>
    <section class="section" id="about"><div class="wrap">
      <div class="section-head reveal"><div><div class="kicker">01 / A little about me</div><h2>Curiosity, in progress.</h2></div><p class="note">A snapshot from my open-source journey. The best projects start with a question and grow through sharing.</p></div>
      <div class="about-grid"><div class="reveal"><p class="about-copy" id="bio">Making, learning, and building in public. I enjoy exploring new ideas, solving interesting problems, and creating things that make the web a little more useful.</p><div class="location" id="location" hidden></div></div>
        <div class="stats reveal"><div class="stat"><b id="repos">—</b><span>Public projects</span></div><div class="stat"><b id="followers">—</b><span>People following</span></div><div class="stat"><b id="stars">—</b><span>Stars earned</span></div><div class="stat"><b id="year">—</b><span>On GitHub since</span></div></div>
      </div>
    </div></section>
    <section class="section projects-section" id="projects"><div class="wrap">
      <div class="section-head reveal"><div><div class="kicker">02 / Selected work</div><h2>Things I’ve made.</h2></div><p class="note">Recent public projects from GitHub. Each one is a chance to learn something new and make it real.</p></div>
      <div class="projects" id="projects-grid" aria-live="polite"><div class="empty">Loading public projects…</div></div>
    </div></section>
    <section class="contact" id="contact"><div class="wrap"><div class="contact-panel reveal">
      <div class="kicker">03 / Let’s connect</div><h2>Have an idea worth building?</h2><p>I’m always up for a thoughtful conversation, a new collaboration, or discovering what you’re making.</p>
      <a class="button primary" href="https://github.com/Hishantkumar" target="_blank" rel="noreferrer">Say hello on GitHub ↗</a>
    </div></div></section>
  </main>
  <footer class="footer"><div class="wrap foot"><span>© <span id="current-year"></span> <span id="footer-name">Hishantkumar</span> · Made with curiosity.</span><a href="#home">Back to top ↑</a></div></footer>
  <script>
    const username = "Hishantkumar";
    const grid = document.getElementById("projects-grid");
    const avatar = document.getElementById("avatar");
    document.getElementById("current-year").textContent = new Date().getFullYear();
    avatar.addEventListener("load", () => { document.getElementById("fallback").hidden = true; });
    avatar.addEventListener("error", () => { avatar.hidden = true; });

    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("visible");
        currentObserver.unobserve(entry.target);
      });
    }, { threshold: .12 });
    document.querySelectorAll(".section .reveal,.contact .reveal").forEach((el, i) => {
      el.style.setProperty("--delay", `${i % 4 * 85}ms`);
      observer.observe(el);
    });

    const safe = (value) => String(value).replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
    const count = (value) => new Intl.NumberFormat("en", { notation: value > 999 ? "compact" : "standard", maximumFractionDigits: 1 }).format(value);

    function showProjects(repositories) {
      const recent = repositories.filter((repo) => !repo.fork).sort((a, b) => new Date(b.pushed_at) - new Date(a.pushed_at)).slice(0, 6);
      if (!recent.length) {
        grid.innerHTML = `<div class="empty">No public projects to show yet. Visit <a href="https://github.com/${username}" target="_blank" rel="noreferrer">my GitHub profile</a> to see what I’m working on.</div>`;
        return;
      }
      grid.innerHTML = recent.map((repo) => `<a class="card reveal" href="${safe(repo.html_url)}" target="_blank" rel="noreferrer">
        <div class="cardtop"><b aria-hidden="true">✳</b><span>↗ VIEW PROJECT</span></div>
        <h3>${safe(repo.name)}</h3><p>${safe(repo.description || "A project built with curiosity. Explore the code and see what it does.")}</p>
        <div class="meta"><span>● ${safe(repo.language || "Open source")}</span><span>★ ${count(repo.stargazers_count)}</span><span>⑂ ${count(repo.forks_count)}</span></div>
      </a>`).join("");
      grid.querySelectorAll(".reveal").forEach((el, i) => {
        el.style.setProperty("--delay", `${i % 3 * 85}ms`);
        observer.observe(el);
      });
    }

    async function loadProfile() {
      try {
        const response = await fetch(`https://api.github.com/users/${username}`, { headers: { Accept: "application/vnd.github+json" } });
        if (!response.ok) throw new Error(`GitHub profile request failed (${response.status}).`);
        const profile = await response.json();
        const name = profile.name || profile.login || username;
        document.title = `${name} — Developer & Builder`;
        document.getElementById("brand-name").textContent = name;
        document.getElementById("hero-name").textContent = name;
        document.getElementById("footer-name").textContent = name;
        document.getElementById("handle").textContent = `@${profile.login}`;
        if (profile.avatar_url) avatar.src = `${profile.avatar_url}&size=600`;
        document.getElementById("repos").textContent = count(profile.public_repos);
        document.getElementById("followers").textContent = count(profile.followers);
        document.getElementById("year").textContent = profile.created_at ? new Date(profile.created_at).getFullYear() : "—";
        if (profile.bio) document.getElementById("bio").textContent = profile.bio;
        if (profile.location) {
          const location = document.getElementById("location");
          location.textContent = `⌖ ${profile.location}`;
          location.hidden = false;
        }
        const projectsResponse = await fetch(`https://api.github.com/users/${username}/repos?sort=updated&per_page=100`, { headers: { Accept: "application/vnd.github+json" } });
        if (!projectsResponse.ok) throw new Error(`GitHub projects request failed (${projectsResponse.status}).`);
        const repositories = await projectsResponse.json();
        document.getElementById("stars").textContent = count(repositories.reduce((total, repo) => total + repo.stargazers_count, 0));
        showProjects(repositories);
      } catch (error) {
        console.error("Unable to load public GitHub portfolio data:", error);
        grid.innerHTML = `<div class="empty">GitHub data couldn’t load right now. You can still <a href="https://github.com/${username}" target="_blank" rel="noreferrer">visit my profile</a> directly.</div>`;
      }
    }
    loadProfile();
  </script>
</body>
</html>
